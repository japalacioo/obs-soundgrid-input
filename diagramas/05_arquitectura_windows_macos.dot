 subgraph cluster_obs {label="PLUGIN OBS · C++20 / libobs (core compartido)";color="#b7cfdd";style="rounded,filled";fillcolor="#f5faff";
  TRANSPORT[label="IAudioTransport\nTransportManager"]; ENGINE[label="PCM + Timestamp\nRingbuffer SPSC\nMapeo / Resampling"]; OUTPUT[label="Fuente nativa OBS\nobs_source_output_audio()",fillcolor="#d4e8ff"];
  HEALTH[label="HealthMonitor\nNIC / Audio / Buffer / Clock",fillcolor="#fff0cb"]; ALERT[label="AlertEngine A01-A10\nHistorial / Recovery",fillcolor="#fff0cb"]; UI[label="SoundGrid Monitor\nCanales / Medidores / Alertas",fillcolor="#fff0cb"];
  TRANSPORT->ENGINE->OUTPUT; TRANSPORT->HEALTH; ENGINE->HEALTH; HEALTH->ALERT->UI;
 }
