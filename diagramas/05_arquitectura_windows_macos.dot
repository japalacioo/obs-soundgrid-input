digraph WINMAC {
 rankdir=LR; bgcolor="transparent"; splines=polyline; pad=0.15; ranksep=0.6; nodesep=0.38;
 graph [fontname="DejaVu Sans",fontsize=12]; node [fontname="DejaVu Sans",shape=box,style="rounded,filled",color="#b7cbd8",fillcolor="#eef5fa",fontcolor="#143650",fontsize=11,margin="0.18,0.12"];
 edge [color="#577d94",penwidth=1.3,arrowsize=0.65];
