  NICW[label="NIC / Telemetria"]; ASIO[label="Waves SoundGrid\nASIO Driver V17",fillcolor="#ddf2ed"]; NICW->ASIO;
 }
 subgraph cluster_mac {label="macOS Intel / Apple Silicon";color="#9ab9e2";style="rounded,filled";fillcolor="#f4f8ff";
